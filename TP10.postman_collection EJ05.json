  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST login - credenciales correctas (debe dar 200 + token)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"usuario\": \"CAMBIAR_POR_TU_AUTH_USUARIO\",\r\n    \"clave\": \"CAMBIAR_POR_TU_AUTH_CLAVE\"\r\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "http://localhost:3000/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "POST login - clave incorrecta (debe dar 401)",
          "request": {
            "auth": { "type": "noauth" },
